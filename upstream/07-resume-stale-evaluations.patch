+        dataset = await _await_or_return(client.datasets.get_dataset(dataset=dataset_id))
+        fail = [True]
+
+        def task(input: dict[str, Any]) -> int:
+            if fail[0] and input["idx"] == 1:
+                raise ValueError("boom")
+            return cast(int, input["idx"])
+
+        def exact(output: Any, expected: dict[str, Any]) -> float:
+            return 1.0 if output == expected["result"] else 0.0
+
+        ran = await _await_or_return(
+            client.experiments.run_experiment(
+                dataset=dataset, task=task, evaluators={"exact": exact}, print_summary=False
+            )
+        )
+        assert "Only 1 out of 2 expected runs" in capsys.readouterr().out
+
+        fail[0] = False
+        await _await_or_return(
+            client.experiments.resume_experiment(
+                experiment_id=ran["experiment_id"],
+                task=task,
+                evaluators={"exact": exact},
+                print_summary=False,
+            )
+        )
+        runs = helper.get_experiment_annotations(ran["experiment_id"])["runs"]["edges"]
+        scores = sorted(
+            a["annotation"]["score"] for r in runs for a in r["run"]["annotations"]["edges"]
+        )
+        assert scores == [1.0, 1.0]
