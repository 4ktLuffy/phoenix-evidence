+    @pytest.mark.parametrize("is_async", [True, False])
+    async def test_resumed_run_is_scored_on_its_new_output(
+        self,
+        is_async: bool,
+        _app: _AppInfo,
+        _setup_experiment_test: _SetupExperimentTest,
+        capsys: pytest.CaptureFixture[str],
+    ) -> None:
+        """
+        A failed run is evaluated on output None. When resume_experiment re-runs it, the old
+        score must not stay as the score of the new output, and the run summary must say that
+        a run failed.
+        """
+        client, helper = _setup_experiment_test(is_async)
+        dataset_id, _ = helper.create_dataset(
+            inputs=[{"idx": 0}, {"idx": 1}], outputs=[{"result": 0}, {"result": 1}]
