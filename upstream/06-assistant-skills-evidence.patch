+    tpr_b = ((p == 1) & (h == 1)).sum() / max((h == 1).sum(), 1)
+    tnr_b = ((p == 0) & (h == 0)).sum() / max((h == 0).sum(), 1)
+    if tpr_b + tnr_b > 1:
+        estimates.append(correct_estimate(observed, tpr_b, tnr_b))
+low, high = np.percentile(estimates, [2.5, 97.5])
