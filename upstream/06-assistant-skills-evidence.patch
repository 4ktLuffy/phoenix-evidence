 def correct_estimate(observed, tpr, tnr):
-    """Adjust observed pass rate using known TPR/TNR."""
-    return (observed - (1 - tnr)) / (tpr - (1 - tnr))
+    """Adjust observed pass rate using TPR/TNR measured on a labeled set."""
+    youden = tpr + tnr - 1
+    if youden <= 0:
+        raise ValueError("judge is no better than chance: TPR + TNR must exceed 1")
+    return min(1.0, max(0.0, (observed - (1 - tnr)) / youden))
