+def test_examples_needed_does_not_depend_on_the_scale() -> None:
+    def scores(scale: float, shift: bool) -> dict[str, list[float | None]]:
+        return {
+            str(i): [scale * (float(i % 5) + (0.5 if shift and i % 2 else 0.0))] for i in range(40)
+        }
+
+    a = compare_scores(scores(1.0, False), scores(1.0, True))
+    b = compare_scores(scores(100.0, False), scores(100.0, True))
+    assert a is not None and b is not None
+    assert a.examples_needed is not None and a.examples_needed == b.examples_needed
