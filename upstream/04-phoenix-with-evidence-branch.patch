@@ -0,0 +1,170 @@
+"""Is a compare experiment's annotation score really different from the base experiment's?
+
+Both experiments ran on the same dataset examples, so each example gives one paired difference
+(compare minus base, each averaged over its repetitions). A run that errored, or whose
+annotation is missing or errored, counts as the worst score seen for that annotation, so an
+experiment cannot look better by failing on the hard examples.
+
+The decision is a sign-flip test on the differences: exact up to 16 examples that differ (Monte
+Carlo with a fixed seed above), under the null that the two experiments are interchangeable on
+each example. The interval on the mean difference is a seeded percentile bootstrap over examples
+and is descriptive. Differences across several annotations are corrected with Holm's method.
+"""
+
+import itertools
+import math
+import random
+from dataclasses import dataclass
+from typing import Literal, Mapping, Optional, Sequence
+
+Verdict = Literal["BETTER", "WORSE", "NO_DETECTABLE_DIFFERENCE"]
+
+_EXACT_LIMIT = 16
+_DRAWS = 20_000
+_BOOTSTRAP = 2_000
+
+
+@dataclass(frozen=True)
+class PairedComparison:
+    base_mean: float
+    compare_mean: float
+    difference: float
+    lower: float
+    upper: float
+    p_value: float
+    examples: int
+    missing_base: int
+    missing_compare: int
+    examples_needed: Optional[int]
+
+
+def example_means(
+    scores: Mapping[str, Sequence[Optional[float]]], missing_as: float
+) -> tuple[dict[str, float], int]:
+    """Mean score per example over its repetitions, with missing scores counted as `missing_as`."""
+    means: dict[str, float] = {}
+    missing = 0
+    for example_id, values in scores.items():
+        filled = []
+        for value in values or [None]:
+            if value is None:
+                missing += 1
+                filled.append(missing_as)
+            else:
+                filled.append(value)
+        means[example_id] = sum(filled) / len(filled)
+    return means, missing
+
+
+def sign_flip_p_value(differences: Sequence[float], seed: int = 0) -> float:
+    """Two-sided p-value for no difference, flipping the sign of each paired difference."""
+    nonzero = [d for d in differences if d != 0]
+    if not nonzero:
+        return 1.0
+    observed = abs(sum(nonzero))
+    tolerance = 1e-12
+    if len(nonzero) <= _EXACT_LIMIT:
+        hits = sum(
+            1
+            for signs in itertools.product((1, -1), repeat=len(nonzero))
+            if abs(sum(s * d for s, d in zip(signs, nonzero))) >= observed - tolerance
+        )
+        return hits / float(2 ** len(nonzero))
+    rng = random.Random(seed)
+    hits = 1
+    for _ in range(_DRAWS):
+        if abs(sum(d if rng.random() < 0.5 else -d for d in nonzero)) >= observed - tolerance:
+            hits += 1
+    return hits / (_DRAWS + 1)
+
+
+def examples_needed_continuous(sd: float, difference: float) -> Optional[int]:
+    """Examples to detect `difference` at 80% power, two-sided 5%, for paired differences with
+    standard deviation `sd` (normal approximation; unchanged when every score is rescaled)."""
+    if difference == 0 or sd <= 0:
+        return None
+    z_alpha, z_beta = 1.959963984540054, 0.8416212335729143
+    return math.ceil(((z_alpha + z_beta) * sd / difference) ** 2)
+
+
+def examples_needed(discordant_share: float, difference: float) -> Optional[int]:
+    """Examples to detect `difference` at 80% power, two-sided 5%.
+
+    Connor (1987), paired proportions, at the observed share of examples that changed.
+    """
+    if difference == 0 or discordant_share <= 0 or abs(difference) > discordant_share:
+        return None
+    z_alpha, z_beta = 1.959963984540054, 0.8416212335729143
+    spread = z_alpha * math.sqrt(discordant_share)
+    spread += z_beta * math.sqrt(discordant_share - difference**2)
+    return math.ceil(spread**2 / difference**2)
+
+
+def compare_scores(
+    base: Mapping[str, Sequence[Optional[float]]],
+    compare: Mapping[str, Sequence[Optional[float]]],
+    seed: int = 0,
+    minimize: bool = False,
+) -> Optional[PairedComparison]:
+    """Paired comparison on the examples both experiments ran; None when they share none.
+
+    A missing score counts as the worst score seen in either experiment: the lowest, or the
+    highest when lower is better (`minimize`).
+    """
+    seen = [
+        value
+        for side in (base, compare)
+        for values in side.values()
+        for value in values
+        if value is not None
+    ]
+    worst = (max(seen) if minimize else min(seen)) if seen else 0.0
+    base_means, missing_base = example_means(base, worst)
+    compare_means, missing_compare = example_means(compare, worst)
+    shared = sorted(set(base_means) & set(compare_means))
+    if not shared:
+        return None
+    differences = [compare_means[k] - base_means[k] for k in shared]
+    n = len(differences)
+    difference = sum(differences) / n
+    rng = random.Random(seed)
+    boots = sorted(
+        sum(differences[rng.randrange(n)] for _ in range(n)) / n for _ in range(_BOOTSTRAP)
+    )
+    binary = all(value in (0.0, 1.0) for value in seen)
+    if binary:
+        needed = examples_needed(sum(1 for d in differences if d != 0) / n, abs(difference))
+    else:
+        mean = difference
+        sd = math.sqrt(sum((d - mean) ** 2 for d in differences) / max(n - 1, 1))
+        needed = examples_needed_continuous(sd, abs(difference))
+    return PairedComparison(
+        base_mean=sum(base_means[k] for k in shared) / n,
+        compare_mean=sum(compare_means[k] for k in shared) / n,
+        difference=difference,
+        lower=boots[int(0.025 * _BOOTSTRAP)],
+        upper=boots[int(0.975 * _BOOTSTRAP) - 1],
+        p_value=sign_flip_p_value(differences, seed),
+        examples=n,
+        missing_base=missing_base,
+        missing_compare=missing_compare,
+        examples_needed=needed,
+    )
+
+
+def holm(p_values: Sequence[float], alpha: float = 0.05) -> list[bool]:
+    """Holm's step-down correction: which p-values are significant together, in input order."""
+    order = sorted(range(len(p_values)), key=lambda i: p_values[i])
+    significant = [False] * len(p_values)
+    for rank, i in enumerate(order):
+        if p_values[i] > alpha / (len(p_values) - rank):
+            break
+        significant[i] = True
+    return significant
+
+
+def verdict(comparison: PairedComparison, significant: bool, minimize: bool = False) -> Verdict:
+    if not significant:
+        return "NO_DETECTABLE_DIFFERENCE"
+    higher = comparison.difference > 0
+    return "BETTER" if higher != minimize else "WORSE"
