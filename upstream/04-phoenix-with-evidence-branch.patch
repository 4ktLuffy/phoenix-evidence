@@ -0,0 +1,74 @@
+import pytest
+
+from phoenix.server.api.helpers.paired_comparison import (
+    compare_scores,
+    examples_needed,
+    holm,
+    sign_flip_p_value,
+    verdict,
+)
+
+
+def test_sign_flip_is_exact_for_few_differences() -> None:
+    assert sign_flip_p_value([1, 1, 1, 1, 1]) == pytest.approx(2 / 32)
+    assert sign_flip_p_value([0, 0]) == 1.0
+
+
+def test_identical_experiments_show_no_difference() -> None:
+    scores: dict[str, list[float | None]] = {str(i): [float(i % 3 != 0)] for i in range(30)}
+    result = compare_scores(scores, dict(scores))
+    assert result is not None
+    assert result.difference == 0 and result.p_value == 1.0
