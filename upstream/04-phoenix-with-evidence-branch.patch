+async def test_experiment_annotation_evidence_scores_failed_runs_and_pairs_examples(
+    gql_client: AsyncGraphQLClient,
+    db: DbSessionFactory,
+) -> None:
+    """
+    20 examples. On "correct", the compare experiment matches the base on the 10 easy examples and
+    errors on the 10 hard ones, which the base also gets wrong: averaging only the runs that
+    finished would show it as 1.0 against 0.5. On "polite", the compare experiment is better on
+    every example.
+    """
+    async with db() as session:
+        dataset = models.Dataset(name="evidence-dataset", metadata_={})
+        session.add(dataset)
+        await session.flush()
+        version = models.DatasetVersion(dataset_id=dataset.id, metadata_={})
+        session.add(version)
+        await session.flush()
+        examples = [models.DatasetExample(dataset_id=dataset.id) for _ in range(20)]
+        session.add_all(examples)
+        await session.flush()
+        experiments = [
+            models.Experiment(
+                dataset_id=dataset.id,
+                dataset_version_id=version.id,
+                name=name,
+                repetitions=1,
+                metadata_={},
+                project_name="evidence-project",
+            )
+            for name in ("base", "compare")
+        ]
+        session.add_all(experiments)
+        await session.flush()
+        start = datetime(2024, 1, 1, tzinfo=timezone.utc)
+        for experiment in experiments:
+            is_compare = experiment.name == "compare"
+            for i, example in enumerate(examples):
+                hard = i >= 10
+                run = models.ExperimentRun(
+                    experiment_id=experiment.id,
+                    dataset_example_id=example.id,
+                    repetition_number=1,
+                    output={},
+                    start_time=start,
+                    end_time=start,
+                    error="timeout" if is_compare and hard else None,
+                )
+                session.add(run)
+                await session.flush()
+                annotations = {"polite": 1.0 if is_compare else 0.0}
+                if not (is_compare and hard):
+                    annotations["correct"] = 0.0 if hard else 1.0
+                for name, score in annotations.items():
+                    session.add(
+                        models.ExperimentRunAnnotation(
+                            experiment_run_id=run.id,
+                            name=name,
+                            annotator_kind="CODE",
+                            label=None,
+                            score=score,
+                            explanation=None,
+                            trace_id=None,
+                            error=None,
+                            metadata_={},
+                            start_time=start,
+                            end_time=start,
+                        )
+                    )
+        await session.commit()
+        base, compare = experiments
+
+    response = await gql_client.execute(
+        query="""
+          query ($baseExperimentId: ID!, $compareExperimentIds: [ID!]!) {
+            experimentAnnotationEvidence(
+              baseExperimentId: $baseExperimentId
+              compareExperimentIds: $compareExperimentIds
+            ) {
+              annotationName
+              baseMean
+              compareMean
+              difference
+              pValue
+              verdict
+              examples
+              missingCompare
+            }
+          }
+        """,
+        variables={
+            "baseExperimentId": str(GlobalID("Experiment", str(base.id))),
+            "compareExperimentIds": [str(GlobalID("Experiment", str(compare.id)))],
+        },
+    )
+    assert not response.errors
+    assert response.data is not None
+    by_name = {row["annotationName"]: row for row in response.data["experimentAnnotationEvidence"]}
+    assert by_name["correct"] == {
+        "annotationName": "correct",
+        "baseMean": 0.5,
+        "compareMean": 0.5,
+        "difference": 0.0,
+        "pValue": 1.0,
+        "verdict": "NO_DETECTABLE_DIFFERENCE",
+        "examples": 20,
+        "missingCompare": 10,
+    }
+    # The 10 failed compare runs score as the worst seen on every annotation, "polite" included,
+    # so the gain is 0.5, not 1.0: it is better on every run that finished.
+    assert by_name["polite"]["verdict"] == "BETTER"
+    assert by_name["polite"]["difference"] == 0.5
+
