+describe("acceptance criteria on an interval", () => {
+  const scored = (count: number, score: boolean, offset = 0): TestResult[] =>
+    Array.from({ length: count }, (_, index) =>
+      createCase(`case-${offset + index}`, [{ name: "correct", score }])
+    );
+
+  it("is undecided when a small suite clears the bar only on its point value", () => {
+    // 13 of 16 correct: 0.81 >= 0.7, but the exact interval is [0.544, 0.960].
+    const results = [...scored(13, true), ...scored(3, false, 13)];
+    const [strict] = evaluateAcceptanceCriteria({
+      criteria: [
+        {
+          annotationName: "correct",
+          metric: "average",
+          threshold: 0.7,
+          interval: {},
+        },
+      ],
+      results,
+    });
+    expect(strict).toMatchObject({
+      value: expect.closeTo(0.8125, 4),
+      verdict: "undecided",
+      exampleCount: 16,
+      passed: false,
+    });
+    expect(strict!.valueInterval![0]).toBeCloseTo(0.5435, 4);
+    expect(strict!.valueInterval![1]).toBeCloseTo(0.9595, 4);
+
+    const [lenient] = evaluateAcceptanceCriteria({
+      criteria: [
+        {
+          annotationName: "correct",
+          metric: "average",
+          threshold: 0.7,
+          interval: { whenUndecided: "pass" },
+        },
+      ],
+      results,
+    });
+    expect(lenient).toMatchObject({ verdict: "undecided", passed: true });
+  });
+
+  it("counts runs that never logged the annotation as failures", () => {
