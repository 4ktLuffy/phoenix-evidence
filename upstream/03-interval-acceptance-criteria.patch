+/**
+ * Decide a criterion on an exact (Clopper-Pearson) interval. Each test counts
+ * once, by the mean of its runs' outcomes, so repetitions do not shrink the
+ * interval; a run without the annotation scores the worst outcome (0, or 1
+ * when minimizing). The interval is taken on
+ * the number of examples, with the summed outcomes rounded down for the lower
+ * bound and up for the upper, which keeps it conservative for fractional
+ * scores.
+ */
+function evaluateOnInterval({
+  criterion,
+  results,
+}: {
+  criterion: AcceptanceCriterion;
+  results: readonly TestResult[];
+}): AcceptanceResult {
+  const confidence = criterion.interval?.confidence ?? 0.95;
+  const alpha = 1 - confidence;
+  const byTest = new Map<string, number[]>();
+  let missingCount = 0;
+  for (const result of results) {
+    if (result.status === "skipped") {
+      continue;
+    }
+    const annotation = findLastAnnotation({
+      annotations: result.annotations,
+      annotationName: criterion.annotationName,
+    });
+    // A run that never scored counts as the worst outcome in the criterion's direction.
+    const worst =
+      criterion.metric === "average" && criterion.direction === "minimize"
+        ? 1
+        : 0;
+    let outcome: number;
+    if (annotation === undefined) {
+      missingCount += 1;
+      outcome = worst;
+    } else if (criterion.metric === "passRate") {
+      outcome = criterion.passFn(annotation) ? 1 : 0;
+    } else {
+      const score = annotation.score;
+      if (!isValidScore(score)) {
+        missingCount += 1;
+        outcome = worst;
+      } else {
+        outcome = typeof score === "boolean" ? Number(score) : score;
+        if (outcome < 0 || outcome > 1) {
+          return {
+            ...criterion,
+            value: null,
+            sampleCount: 0,
+            passed: false,
+            failureReason: "interval criteria need scores between 0 and 1",
+          };
+        }
+      }
+    }
+    // Repetitions of one test share an example: the runner names them `<name> [rep i/N]`.
+    const exampleKey =
+      result.exampleId ?? result.testName.replace(/ \[rep \d+\/\d+\]$/, "");
+    const outcomes = byTest.get(exampleKey) ?? [];
+    outcomes.push(outcome);
+    byTest.set(exampleKey, outcomes);
+  }
+  const shares = [...byTest.values()].map(calculateAverage);
+  const exampleCount = shares.length;
+  if (exampleCount === 0) {
+    return {
+      ...criterion,
+      value: null,
+      sampleCount: 0,
+      passed: false,
+      failureReason: "no runs to decide on",
+    };
+  }
+  const total = shares.reduce((sum, share) => sum + share, 0);
+  const valueInterval: [number, number] = [
+    clopperPearson(Math.floor(total + 1e-9), exampleCount, alpha)[0],
+    clopperPearson(Math.ceil(total - 1e-9), exampleCount, alpha)[1],
+  ];
+  const [low, high] = valueInterval;
+  const bar =
+    criterion.metric === "passRate"
+      ? criterion.minPassRate
+      : criterion.threshold;
+  const minimize =
+    criterion.metric === "average" && criterion.direction === "minimize";
+  let verdict: "pass" | "fail" | "undecided";
+  if (minimize) {
+    verdict = high <= bar ? "pass" : low > bar ? "fail" : "undecided";
+  } else {
+    verdict = low >= bar ? "pass" : high < bar ? "fail" : "undecided";
+  }
+  const passesWhenUndecided = criterion.interval?.whenUndecided === "pass";
+  return {
+    ...criterion,
+    value: total / exampleCount,
+    sampleCount: [...byTest.values()].reduce((n, runs) => n + runs.length, 0),
+    passed:
+      verdict === "pass" || (verdict === "undecided" && passesWhenUndecided),
+    valueInterval,
+    verdict,
+    exampleCount,
+    missingCount,
+    failureReason:
+      verdict === "undecided" && !passesWhenUndecided
+        ? `the interval contains the bar: ${exampleCount} examples cannot decide`
+        : undefined,
+  };
+}
+
+/** P(X <= k) for X ~ Binomial(n, p), summed in log space. */
+function binomialCdf(k: number, n: number, p: number): number {
+  if (k < 0) return 0;
+  if (k >= n || p <= 0) return 1;
+  if (p >= 1) return 0;
+  const logP = Math.log(p);
+  const logQ = Math.log1p(-p);
+  const logN = logGamma(n + 1);
+  const terms: number[] = [];
+  for (let i = 0; i <= k; i++) {
+    terms.push(
+      logN - logGamma(i + 1) - logGamma(n - i + 1) + i * logP + (n - i) * logQ
+    );
+  }
+  const top = Math.max(...terms);
+  return Math.min(
+    1,
+    Math.exp(top) * terms.reduce((sum, t) => sum + Math.exp(t - top), 0)
+  );
+}
+
+/** Lanczos approximation of log Γ(x), accurate to ~1e-13 for x > 0. */
+function logGamma(x: number): number {
+  const g = 7;
+  const c = [
+    0.99999999999980993, 676.5203681218851, -1259.1392167224028,
+    771.32342877765313, -176.61502916214059, 12.507343278686905,
+    -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7,
+  ];
+  if (x < 0.5) {
+    return Math.log(Math.PI / Math.sin(Math.PI * x)) - logGamma(1 - x);
+  }
+  const z = x - 1;
+  let a = c[0]!;
+  const t = z + g + 0.5;
+  for (let i = 1; i < g + 2; i++) {
+    a += c[i]! / (z + i);
+  }
+  return (
+    0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(a)
+  );
+}
+
+/** Exact two-sided binomial interval for `successes` out of `trials`. */
+function clopperPearson(
+  successes: number,
+  trials: number,
+  alpha: number
+): [number, number] {
+  const upper = (k: number): number => {
+    if (k >= trials) return 1;
+    let low = k / trials;
+    let high = 1;
+    for (let i = 0; i < 60; i++) {
+      const mid = (low + high) / 2;
+      if (binomialCdf(k, trials, mid) > alpha / 2) low = mid;
+      else high = mid;
+    }
+    return high;
+  };
+  return [1 - upper(trials - successes), upper(successes)];
+}
