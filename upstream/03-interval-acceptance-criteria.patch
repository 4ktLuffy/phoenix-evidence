+        ...createCase(`crash-${index}`, []),
+        status: "failed" as const,
+      })),
+    ];
+    const [result] = evaluateAcceptanceCriteria({
+      criteria: [
+        {
+          annotationName: "correct",
+          metric: "passRate",
+          passFn: (annotation) => annotation.score === true,
